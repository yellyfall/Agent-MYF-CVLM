# FICHIER POUR HETZNER UNIQUEMENT. Ne pas envoyer sur Render ni sur GitHub.
# Copier vers .env puis remplacer les valeurs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-long-et-unique
APP_SECRET=remplacer-par-un-secret-aleatoire-de-64-caracteres
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MAX_CONCURRENT_GENERATIONS=2
DAILY_GENERATION_LIMIT=20
# Domaine DNS pointant vers l'IP publique du serveur Hetzner, sans https://
DOMAIN=api.votre-domaine.fr
# Origine exacte du site Render : https:// inclus, aucun slash final.
APP_ORIGIN=https://myf-candidature-frontend.onrender.com
# Aucune DATABASE_URL nécessaire : SQLite reste dans le volume sur Hetzner.

